# DocuAX Backend (개발용 — 디버그 활성)
FROM python:3.11-slim

# 시스템 의존성 — LibreOffice (HWPX/PDF 폴백), 한국어 폰트, weasyprint
RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-core libreoffice-writer \
    fonts-nanum fonts-noto-cjk \
    libpango-1.0-0 libpangoft2-1.0-0 \
    libcairo2 libgdk-pixbuf-2.0-0 \
    libffi-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY apps/backend/pyproject.toml ./
RUN pip install --no-cache-dir -e . || pip install --no-cache-dir \
    "fastapi>=0.115.0" "uvicorn[standard]>=0.32.0" \
    "pydantic>=2.9.0" "pydantic-settings>=2.5.0" \
    "sqlalchemy>=2.0.35" "aiosqlite>=0.20.0" \
    "httpx>=0.27.0" "orjson>=3.10.0" "structlog>=24.4.0" \
    "python-docx>=1.1.2" "python-hwpx>=0.2.0" \
    "markdown-it-py>=3.0.0" "weasyprint>=63.0" \
    "openai>=1.54.0" "anthropic>=0.39.0" \
    "chromadb>=0.5.15" "sentence-transformers>=3.2.0"

COPY apps/backend/app /app/app
COPY apps/backend/.env.example /app/.env.example

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
