# DocuAX 백엔드 환경 설정 예시
# 운영 시: 이 파일을 .env 로 복사 후 [필수] 표시 항목을 모두 채울 것
# 개발 시: 기본값만으로도 동작 (mock provider)
#
# 보안 권장:
#   - 모든 secret 은 `openssl rand -hex 32` 로 생성
#   - DB 비밀번호는 .env 외부 (Secret Manager, AWS SSM 등)에서 주입 권장
#   - .env 는 절대 commit 금지 (.gitignore 에 등록되어 있음)
#

# ─── 환경 ────────────────────────────────────────────
APP_ENV=development                    # development | staging | production
APP_DEBUG=true                          # 운영 false 권장
APP_HOST=0.0.0.0
APP_PORT=8000
# [필수, 운영] JWT 서명 비밀키 — 운영에서 반드시 교체. 32바이트 hex 권장.
# 생성:  openssl rand -hex 32
APP_SECRET_KEY=change-me-in-production-please

# ─── 데이터베이스 ─────────────────────────────────────
# 개발: sqlite. 운영: PostgreSQL 권장 (동시성·백업·복제)
DATABASE_URL=sqlite+aiosqlite:///./docuax.db
# 운영 예시:
# DATABASE_URL=postgresql+asyncpg://docuax:strongpw@db.internal:5432/docuax

# ─── 관리자 권한 ──────────────────────────────────────
# 콤마 구분 이메일 화이트리스트. `*@domain` 와일드카드 지원.
# 예: "admin@docuax.io, *@tenai.kr"
# 화이트리스트에 포함되거나 plan=enterprise 이면 admin 권한.
ADMIN_EMAILS=specialdatastrategist@gmail.com

# ─── LLM Provider ────────────────────────────────────
# tenos | tenos_hf | openai | anthropic | mock | chain
# 운영 권장: tenos (자체 호스팅) 또는 chain (자체 + 외부 폴백)
LLM_PROVIDER=mock

# TenOS — 자체 vLLM 서빙 (운영 기본값)
TENOS_BASE_URL=http://localhost:8001/v1
TENOS_MODEL=honey90/TenOS-Ko-28B
TENOS_API_KEY=local-no-auth
TENOS_TIMEOUT_S=60

# HF Inference API (TenOS 모델을 HF 에서 호출 — GPU 없을 때)
HF_API_TOKEN=

# OpenAI (백업·개발)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (백업)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Chain — 폴백 순서 (LLM_PROVIDER=chain 일 때만)
LLM_CHAIN=tenos,openai

# ─── 임베딩 (RAG) ─────────────────────────────────────
EMBEDDING_PROVIDER=local                # tenos | openai | local
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask

# ─── OCR (스캔 PDF) ────────────────────────────────────
OCR_PROVIDER=none                       # none | tesseract | clova
OCR_TESSERACT_CMD=                      # 빈 값이면 PATH 자동 검색
OCR_DEFAULT_LANG=kor+eng
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=

# ─── RAG ──────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
RAG_TOP_K=5

# ─── 스토리지 ─────────────────────────────────────────
STORAGE_BACKEND=local                   # local | s3
STORAGE_LOCAL_DIR=./data/documents
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── 보안·인증 ────────────────────────────────────────
# 운영 도메인을 정확히 명시. * 사용 금지.
# 예: "https://www.docuax.com, https://docuax.com"
CORS_ORIGINS=http://localhost:3000
JWT_ALGORITHM=HS256
JWT_EXPIRES_MIN=1440                    # 24시간

# ─── On-premise 모드 ──────────────────────────────────
# true 설정 시 외부 API(openai·anthropic) 호출 자동 차단 — 망분리 환경 대응
ON_PREMISE=false

# ─── Stripe (결제, 선택) ───────────────────────────────
# 운영 활성화 절차:
#   1) https://dashboard.stripe.com/apikeys 에서 sk_live_... 발급
#   2) Price 4개(Pro/Team 월·연) 생성: scripts/stripe_setup.py 실행
#   3) Webhook 엔드포인트 등록: https://api.docuax.com/api/v1/billing/webhook
#   4) Webhook signing secret(whsec_...) 을 STRIPE_WEBHOOK_SECRET 에 입력
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel

# ─── Rate Limit (P0-3) ─────────────────────────────────
# 분당 IP별 요청 한도. 0 = 비활성. 운영 권장값: 60~120
RATE_LIMIT_DEFAULT_PER_MIN=120
# 로그인·가입 등 인증 엔드포인트는 별도 제한 (무차별 공격 방지)
RATE_LIMIT_AUTH_PER_MIN=10
# 변환은 무거우므로 별도 제한
RATE_LIMIT_CONVERT_PER_MIN=30
